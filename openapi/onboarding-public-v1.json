{
  "openapi":"3.1.0",
  "info":{"title":"Momna ONB-API-01 Onboarding Public API","version":"1.0.0","description":"Canonical onboarding fragment for the shared /api/v1 Flow protocol. This fragment is subordinate to the repository root Core OpenAPI and adds no period-specific backend API.","x-observability":{"correlationHeaders":["X-Request-Id","X-Trace-Id"],"sensitiveValuePolicy":"NEVER_LOG_OR_TAG_RAW_ONBOARDING_VALUES"}},
