# Names/placeholders only. Never commit real values.
MOMNA_ENV=local
MOMNA_ROLE=api
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/momna
DATABASE_USER=<runtime-secret-reference>
DATABASE_PASSWORD=<runtime-secret-reference>
DATABASE_MAX_POOL_SIZE=10

REDIS_URL=redis://localhost:6379
MOMNA_REDIS_ENABLED=false
MOMNA_REDIS_PREFIX=momna

MOMNA_OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=<runtime-config>
OBJECT_STORAGE_REGION=<runtime-config>
OBJECT_STORAGE_ACCESS_KEY_ID=<runtime-secret-reference>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<runtime-secret-reference>
OBJECT_STORAGE_DIARY_BUCKET=<private-bucket-name>
OBJECT_STORAGE_MEDICAL_BUCKET=<private-bucket-name>

MOMNA_DEFAULT_LOCALE=en-US
MOMNA_DEFAULT_TIMEZONE=UTC
