{
  "info": {
    "name": "Momna Java API Security Boundary Coverage",
    "description": "All documented API operations: unauthenticated/invalid request checks only. DOES NOT prove success-path or state-transition parity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "item": [
    {
      "name": "Authentication boundary for all protected API operations",
      "item": [
        {
          "name": "POST /api/v1/flow-instances rejects unauthenticated caller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "java-security-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/flow-instances",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthenticated request is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('does not expose credentials', function () { var text=pm.response.text(); ['accessHash','refreshHash','providerSubject','refreshCredential'].forEach(function(key){pm.expect(text).not.to.include(key);}); });"
                ]
              }
            }
          ]
        },
