      "SubmitOnboardingAnswerRequest":{"type":"object","additionalProperties":false,"required":["value","expectedRevision"],"properties":{"value":{},"mode":{"type":"string","enum":["SUBMIT","CHANGE"]},"expectedDefinitionVersion":{"type":"integer","minimum":1},"expectedRevision":{"type":"integer","minimum":0}}},
      "FlowRevisionRequest":{"type":"object","additionalProperties":false,"required":["expectedRevision"],"properties":{"expectedDefinitionVersion":{"type":"integer","minimum":1},"expectedRevision":{"type":"integer","minimum":0},"manualPeriod":{"$ref":"#/components/schemas/MomnaPeriod"}}},
      "OnboardingStepView":{"type":"object","additionalProperties":true,"required":["fieldId","required","skippable"],"properties":{"stepId":{"type":"string"},"fieldId":{"type":"string"},"componentType":{"type":"string"},"valueType":{"type":"string"},"required":{"type":"boolean"},"skippable":{"type":"boolean"},"options":{"type":"array","items":{"type":"object"}},"validation":{"type":"object"},"presentation":{"type":"object"},"privacy":{"type":"object"},"safety":{"type":"object"}}},
      "SafetyDecisionView":{"type":"object","additionalProperties":false,"required":["state","decisionVersion","allowedActions"],"properties":{"state":{"type":"string","enum":["CLEAR","CLARIFICATION_REQUIRED","ACTION_REQUIRED","BLOCKING"]},"routeCode":{"type":["string","null"]},"severity":{"type":["string","null"]},"decisionVersion":{"type":"string"},"toneOverride":{"type":["string","null"]},"allowedActions":{"type":"array","items":{"type":"string"}},"contentKey":{"type":["string","null"]}}},
      "OnboardingFlowState":{"type":"object","additionalProperties":true,"required":["instanceId","flowType","definitionVersion","status","revision","currentStep","allowedActions"],"properties":{"instanceId":{"type":"string"},"flowType":{"type":"string","enum":["LIFECYCLE_ROUTER","PERIOD_ONBOARDING"]},"period":{"oneOf":[{"$ref":"#/components/schemas/MomnaPeriod"},{"type":"null"}]},"periodSubstage":{"type":["string","null"]},"definitionVersion":{"oneOf":[{"type":"integer"},{"type":"string"}]},"schemaVersion":{"type":"string"},"locale":{"type":"string"},"status":{"type":"string","enum":["DRAFT","IN_PROGRESS","COMPLETED","CANCELLED"]},"revision":{"type":"integer","minimum":0},"currentStep":{"oneOf":[{"$ref":"#/components/schemas/OnboardingStepView"},{"type":"null"}]},"answeredFieldIds":{"type":"array","items":{"type":"string"}},"invalidatedFieldIds":{"type":"array","items":{"type":"string"}},"safetyState":{"oneOf":[{"$ref":"#/components/schemas/SafetyDecisionView"},{"type":"null"}]},"consentState":{"type":["object","null"]},"idempotentReplay":{"type":"boolean"},"allowedActions":{"type":"array","items":{"type":"string"}}}},
      "OnboardingCompletionResult":{"type":"object","additionalProperties":true,"required":["instanceId"],"properties":{"resultType":{"type":"string","enum":["LIFECYCLE_ROUTER","PERIOD_ONBOARDING"]},"instanceId":{"type":"string"},"definitionKey":{"type":"string"},"definitionVersion":{"oneOf":[{"type":"integer"},{"type":"string"}]},"completed":{"type":"boolean"},"safeSummary":{"type":"object"},"downstream":{"type":"object"},"contextState":{"type":"string"},"routerProposal":{"type":["object","null"]},"safetyState":{"oneOf":[{"$ref":"#/components/schemas/SafetyDecisionView"},{"type":"null"}]}}},
      "ApiProblem":{"type":"object","additionalProperties":false,"required":["code","message","requestId"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"requestId":{"type":"string"}}}
    }
  }
