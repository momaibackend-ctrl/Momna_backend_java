{
  "info": {
    "_postman_id": "b2f0f5a8-cc39-4a44-9db1-202610210001",
    "name": "Momna Java PR29 Network HTTP E2E",
    "description": "Network-level checks against the real Java Spring Boot process in a disposable PostgreSQL environment. The contract-surface group probes every operation in the repository OpenAPI inventory; protected routes deliberately assert unauthenticated denial because this isolated environment has no configured email delivery or external identity provider. Safety business rules are covered by Java tests, not claimed as exercised by these unauthenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
