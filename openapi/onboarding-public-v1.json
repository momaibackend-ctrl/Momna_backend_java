    "responses":{"Problem":{"description":"Standard safe API problem","headers":{"X-Request-Id":{"$ref":"#/components/headers/XRequestId"},"X-Trace-Id":{"$ref":"#/components/headers/XTraceId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiProblem"}}}},"FlowState":{"description":"Authoritative Flow state","headers":{"X-Request-Id":{"$ref":"#/components/headers/XRequestId"},"X-Trace-Id":{"$ref":"#/components/headers/XTraceId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OnboardingFlowState"}}}}},
    "schemas":{
